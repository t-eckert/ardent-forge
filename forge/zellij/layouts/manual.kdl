// Manual dev session — one per repo, named after the repo.
// Attach with: ssh box -t zellij attach <repo-name>
layout {
    pane size=1 borderless=true {
        plugin location="zellij:tab-bar"
    }
    pane split_direction="horizontal" {
        pane {
            name "shell"
        }
        pane size=80 {
            name "editor"
            command "nvim"
        }
    }
    pane size=2 borderless=true {
        plugin location="zellij:status-bar"
    }
}
