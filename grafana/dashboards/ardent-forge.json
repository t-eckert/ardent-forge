{
  "id": null,
  "uid": "ardent-forge-app",
  "title": "Ardent Forge",
  "tags": ["ardent-forge", "application"],
  "editable": true,
  "timezone": "browser",
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "title": "Scrape Health",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ]
        }
      },
      "targets": [
        { "expr": "up{job=\"ardent-forge\"}", "legendFormat": "" }
      ]
    },
    {
      "id": 2,
      "title": "Queue Depth",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0", "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 10 } ] } } },
      "targets": [
        { "expr": "forge_queue_depth", "legendFormat": "" }
      ]
    },
    {
      "id": 3,
      "title": "Active Tasks",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0" } },
      "targets": [
        { "expr": "forge_active_tasks", "legendFormat": "" }
      ]
    },
    {
      "id": 4,
      "title": "Total Completed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0", "color": { "mode": "fixed", "fixedColor": "green" } } },
      "targets": [
        { "expr": "sum(forge_tasks_total{status=\"completed\"})", "legendFormat": "" }
      ]
    },
    {
      "id": 5,
      "title": "Total Failed",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0", "color": { "mode": "fixed", "fixedColor": "red" } } },
      "targets": [
        { "expr": "sum(forge_tasks_total{status=\"failed\"})", "legendFormat": "" }
      ]
    },
    {
      "id": 6,
      "title": "Ticks Total",
      "type": "stat",
      "gridPos": { "h": 4, "w": 4, "x": 20, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0" } },
      "targets": [
        { "expr": "forge_ticks_total", "legendFormat": "" }
      ]
    },
    {
      "id": 10,
      "title": "Task Throughput",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "ops",
          "custom": { "fillOpacity": 15 }
        }
      },
      "targets": [
        {
          "expr": "sum by (status) (rate(forge_tasks_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 11,
      "title": "Task Duration (p95) by Type",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (type, le) (rate(forge_task_duration_seconds_bucket[15m])))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 12,
      "title": "Pipeline Stage Duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (stage, le) (rate(forge_task_stage_duration_seconds_bucket[15m])))",
          "legendFormat": "{{stage}}"
        }
      ]
    },
    {
      "id": 13,
      "title": "Tasks by Type",
      "type": "piechart",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0" } },
      "targets": [
        {
          "expr": "sum by (type) (forge_tasks_total)",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 14,
      "title": "Handler Errors",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 12 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "unit": "ops",
          "custom": { "fillOpacity": 15 }
        }
      },
      "targets": [
        {
          "expr": "sum by (type) (rate(forge_handler_errors_total[5m]))",
          "legendFormat": "{{type}}"
        }
      ]
    },
    {
      "id": 15,
      "title": "Tick Duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "s" } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(forge_tick_duration_seconds_bucket[15m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 16,
      "title": "Linear Polls",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "ops", "custom": { "fillOpacity": 15 } } },
      "targets": [
        {
          "expr": "sum by (result) (rate(forge_linear_polls_total[5m]))",
          "legendFormat": "{{result}}"
        }
      ]
    },
    {
      "id": 17,
      "title": "Linear Tasks Ingested",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 20 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "short", "custom": { "fillOpacity": 15 } } },
      "targets": [
        {
          "expr": "rate(forge_linear_tasks_ingested_total[5m])",
          "legendFormat": "ingested"
        }
      ]
    },
    {
      "id": 20,
      "title": "Chat Turns by Shape",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 0, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "ops", "custom": { "fillOpacity": 15 } } },
      "targets": [
        {
          "expr": "sum by (shape) (rate(forge_chat_turns_total[5m]))",
          "legendFormat": "{{shape}}"
        }
      ]
    },
    {
      "id": 21,
      "title": "Chat Tool Calls by Result",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 6, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "ops", "custom": { "fillOpacity": 15 } } },
      "targets": [
        {
          "expr": "sum by (tool, result) (rate(forge_chat_tool_calls_total[5m]))",
          "legendFormat": "{{tool}} · {{result}}"
        }
      ]
    },
    {
      "id": 22,
      "title": "Chat Turn Duration (p95)",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 12, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "s", "custom": { "fillOpacity": 10 } } },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(forge_chat_turn_duration_seconds_bucket[5m])))",
          "legendFormat": "p95"
        }
      ]
    },
    {
      "id": 23,
      "title": "Resolution Posts by Agent",
      "type": "timeseries",
      "gridPos": { "h": 8, "w": 6, "x": 18, "y": 28 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "short", "custom": { "fillOpacity": 15 } } },
      "targets": [
        {
          "expr": "sum by (agent) (increase(forge_resolution_posts_total[1h]))",
          "legendFormat": "{{agent}}"
        }
      ]
    },
    {
      "id": 24,
      "title": "Connector Health",
      "type": "stat",
      "gridPos": { "h": 6, "w": 12, "x": 0, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "mappings": [
            { "type": "value", "options": { "1": { "text": "UP", "color": "green" }, "0": { "text": "DOWN", "color": "red" } } }
          ]
        }
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "orientation": "horizontal", "textMode": "value_and_name" },
      "targets": [
        { "expr": "forge_connector_health", "legendFormat": "{{connector}}" }
      ]
    },
    {
      "id": 25,
      "title": "Memory Activity",
      "type": "timeseries",
      "gridPos": { "h": 6, "w": 12, "x": 12, "y": 36 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "fieldConfig": { "defaults": { "noValue": "0", "unit": "ops", "custom": { "fillOpacity": 15 } } },
      "targets": [
        { "expr": "rate(forge_memory_reads_total[5m])", "legendFormat": "reads" },
        { "expr": "rate(forge_memory_writes_total[5m])", "legendFormat": "writes" }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 2
}
