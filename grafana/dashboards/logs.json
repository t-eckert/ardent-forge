{
  "id": null,
  "uid": "ardent-forge-logs",
  "title": "Logs",
  "tags": ["logs", "loki"],
  "editable": true,
  "timezone": "browser",
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "unit",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "unit", "type": 1 },
        "current": { "text": "ardent-forge.service", "value": "ardent-forge.service" },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "level",
        "type": "query",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": { "label": "level", "type": 1 },
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "allValue": ".+",
        "multi": true,
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log Volume by Unit",
      "type": "barchart",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "loki" },
      "fieldConfig": {
        "defaults": {
          "custom": { "stacking": { "mode": "normal" } }
        }
      },
      "targets": [
        {
          "expr": "sum by (unit) (count_over_time({unit=~\"$unit\", level=~\"$level\"}[1m]))",
          "legendFormat": "{{unit}}"
        }
      ]
    },
    {
      "id": 2,
      "title": "Logs",
      "type": "logs",
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 6 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "showCommonLabels": false,
        "wrapLogMessage": true,
        "prettifyLogMessage": false,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "dedupStrategy": "none"
      },
      "targets": [
        {
          "expr": "{unit=~\"$unit\", level=~\"$level\"}",
          "legendFormat": ""
        }
      ]
    },
    {
      "id": 3,
      "title": "Errors",
      "type": "logs",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 24 },
      "datasource": { "type": "loki", "uid": "loki" },
      "options": {
        "showTime": true,
        "showLabels": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "expr": "{unit=~\"$unit\"} |~ \"(?i)(error|exception|traceback|fatal)\"",
          "legendFormat": ""
        }
      ]
    }
  ],
  "schemaVersion": 39,
  "version": 1
}
