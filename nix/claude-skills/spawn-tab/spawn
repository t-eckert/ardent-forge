#!/usr/bin/env bash
# Open a named Zellij tab running an interactive Claude Code session.
#
#   spawn [options] NAME [PROMPT] [-- CLAUDE_ARGS...]
#   echo PROMPT | spawn [options] NAME
#
#   -d DIR        directory the session starts in (default: the current one)
#   -w WORKTREE   start the session in a new git worktree of that name
#   -s SESSION    Zellij session (default: $ZELLIJ_SESSION_NAME)
#   --focus       switch every attached client to the new tab
#   --max N       refuse when the session already has N tabs (default: 8)
#   --min-free MB refuse when less memory than this is available (default: 2000)
#   --report-to SESSION
#                 end the brief by asking for a report to that Claude Code
#                 session, by the name ListAgents gives it
#   --dry-run     print the command, open nothing
#
# The tab is named in Title Case whatever case NAME arrives in, and the
# session takes the same name. Prints the new tab's id; when the name was
# changed, the name used goes to stderr.
#
# The session inherits the Zellij server's
# environment, not the caller's, so nothing from an agent's own session leaks
# into it.
set -euo pipefail

die() { echo "spawn: $*" >&2; exit 1; }

dir=$PWD worktree="" session=${ZELLIJ_SESSION_NAME:-} focus=0 max=8 min_free=2000 dry=0 report_to=""
positional=() extra=()

# Raises first letters and lowers nothing, so "PR review" keeps its acronym.
# Short joining words stay lowercase between the first and last word.
title_case() {
  local small=" a an and as at but by for in nor of on or the to via vs with "
  local words out=() i last
  read -ra words <<<"$1"
  last=$((${#words[@]} - 1))
  for i in "${!words[@]}"; do
    if ((i > 0 && i < last)) && [[ $small == *" ${words[i]} "* ]]; then
      out+=("${words[i]}")
    else
      out+=("${words[i]^}")
    fi
  done
  printf '%s' "${out[*]}"
}
while (($#)); do
  case $1 in
    -d) dir=${2:?-d needs a directory}; shift 2 ;;
    -w) worktree=${2:?-w needs a name}; shift 2 ;;
    -s) session=${2:?-s needs a session}; shift 2 ;;
    --max) max=${2:?--max needs a number}; shift 2 ;;
    --min-free) min_free=${2:?--min-free needs a number of megabytes}; shift 2 ;;
    --report-to) report_to=${2:?--report-to needs a session name}; shift 2 ;;
    --focus) focus=1; shift ;;
    --dry-run) dry=1; shift ;;
    -h|--help) sed -n '2,23p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    --) shift; extra=("$@"); break ;;
    -*) die "unknown option $1" ;;
    *) positional+=("$1"); shift ;;
  esac
done

((${#positional[@]} >= 1)) || die "a tab name is required"
((${#positional[@]} <= 2)) || die "one name and one prompt; quote the prompt"
name=${positional[0]}
prompt=${positional[1]:-}
# Only a pipe or a file: an agent's shell often has a stdin that is neither
# a terminal nor closed, and reading it would hang.
if [[ -z $prompt && ( -p /dev/stdin || -f /dev/stdin ) ]]; then prompt=$(cat); fi

[[ $name =~ ^[A-Za-z0-9][A-Za-z0-9\ ._-]{0,31}$ ]] || die "tab name must be 1-32 letters, digits, spaces, dots, dashes or underscores"
given=$name
name=$(title_case "$name")
[[ $name == "$given" ]] || echo "spawn: tab named '$name'" >&2
[[ $prompt != -* ]] || die "a prompt starting with '-' would be read as an option"
[[ $max =~ ^[0-9]+$ ]] || die "--max must be a number"
[[ $min_free =~ ^[0-9]+$ ]] || die "--min-free must be a number of megabytes"
if [[ -n $report_to ]]; then
  [[ -n $prompt ]] || die "--report-to needs a prompt to attach the request to"
  [[ $report_to != *$'\n'* && $report_to != *'"'* ]] || die "the session name must be one line with no double quotes"
  [[ $report_to != "$name" ]] || die "the tab cannot report to itself; name it differently from the session it reports to"
  prompt+=$'\n\n---\n'"When this work is finished, or as soon as you are blocked, send one report to the Claude Code session named \"$report_to\" with the SendMessage tool. Load the tool with ToolSearch if it is not listed. Make the first line the outcome in one sentence. Then say what you changed and where, what you checked, and what is still open. Thomas may also talk to you in this tab; what he says comes first."
fi
[[ -n $session ]] || die "no Zellij session: set ZELLIJ_SESSION_NAME or pass -s"
dir=$(realpath -e -- "$dir" 2>/dev/null) || die "no such directory"
[[ -d $dir ]] || die "$dir is not a directory"
claude=$(command -v claude) || die "claude is not on PATH"

zj() { zellij --session "$session" action "$@"; }

tabs=$(zj query-tab-names) || die "cannot reach Zellij session '$session'"
# A tab whose session is waiting carries one of the attention hook's prefixes.
tabs=$(sed -E 's/^(●|◆) //' <<<"$tabs")
if grep -Fxqi -- "$name" <<<"$tabs"; then die "a tab named '$name' is already open"; fi
count=$(grep -c . <<<"$tabs" || true)
((count < max)) || die "session '$session' already has $count tabs (limit $max); close one first"
available=$(awk '/^MemAvailable:/ {print int($2 / 1024)}' /proc/meminfo)
((available >= min_free)) || die "only $available MB of memory is available (limit $min_free); close a session first"

cmd=("$claude" --name "$name")
[[ -n $worktree ]] && cmd+=(--worktree "$worktree")
((${#extra[@]})) && cmd+=("${extra[@]}")
[[ -n $prompt ]] && cmd+=("$prompt")

tab_args=(--name "$name" --cwd "$dir")
((focus)) || tab_args+=(--no-focus)

if ((dry)); then
  printf 'zellij --session %q action new-tab' "$session"
  printf ' %q' "${tab_args[@]}" -- "${cmd[@]}"
  echo
  exit 0
fi

tab_id=$(zj new-tab "${tab_args[@]}" -- "${cmd[@]}")

# What `close` needs to find this tab again and clean up after it.
record_dir=/tmp/claude-spawn-$(id -u)/$session
mkdir -p -m 700 "$record_dir"
jq -n --arg name "$name" --arg dir "$dir" --arg worktree "$worktree" \
  '{name: $name, dir: $dir, worktree: $worktree}' >"$record_dir/$tab_id"

echo "$tab_id"
