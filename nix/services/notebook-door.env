# Resolved by `op run` at the door's start: references, not secrets. One token
# per caller, each named in /etc/ardent-forge/notebook-door.json, which maps it
# to that caller's grant. A caller whose token is missing here cannot connect.
STET_INTAKE_TOKEN=op://Ardent Forge/notebook-door-stet/intake
STET_VALIDATOR_TOKEN=op://Ardent Forge/notebook-door-stet/validator
STET_MENTIONS_TOKEN=op://Ardent Forge/notebook-door-stet/mentions
STET_PROJECT_UPDATES_TOKEN=op://Ardent Forge/notebook-door-stet/project-updates
STET_DIGEST_TOKEN=op://Ardent Forge/notebook-door-stet/digest
STET_RESEARCH_TOKEN=op://Ardent Forge/notebook-door-stet/research
