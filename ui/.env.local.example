# Hybrid dev: run `pnpm dev` on another machine (e.g. a Mac) with the UI
# pointed at the live Forge on the box over Tailscale.
#
# Copy this file to ui/.env.local (gitignored) to activate:
#   cp ui/.env.local.example ui/.env.local
#
# Requires the machine to be on the tailnet. Leave unset to use localhost:7030.
VITE_API_PROXY=https://ardent-forge.feist-gondola.ts.net
